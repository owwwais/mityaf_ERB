# ── قاعدة البيانات ────────────────────────────────────────────────
# اتركه فارغاً للتشغيل المحلي: يعمل النظام على Postgres مضمَّن (PGlite)
# ويحفظ البيانات في مجلد .data داخل المشروع.
#
# للإنتاج ضع رابط أي قاعدة Postgres:
#   Neon:     postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
#   Supabase: postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ── الجلسات ───────────────────────────────────────────────────────
# مفتاح توقيع الجلسات. مطلوب في الإنتاج. ولّده بالأمر:  openssl rand -base64 32
# محلياً يُولَّد تلقائياً ويُحفظ في .data/auth-secret إن تُرك فارغاً.
AUTH_SECRET=
